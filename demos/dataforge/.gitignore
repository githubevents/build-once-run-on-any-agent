# Build state written by forge-builder during a run
skills/forge-builder/.build-state/*
!skills/forge-builder/.build-state/.gitkeep

# Resolved manifest written by forge-init. Generated per environment and
# disposable — the seed is the tracked source.
dataforge.manifest.resolved.yaml

# Scratch space for forge-builder Phase 7 (PR body drafts)
.forge/

# DuckDB databases generated by the example project
*.duckdb
*.duckdb.wal

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# OS
.DS_Store
.cursor/
